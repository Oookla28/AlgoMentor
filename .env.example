# python scripts/bootstrap.py 自动创建开发密钥；生产必须自行配置并妥善备份。
DJANGO_SECRET_KEY=
APP_ENCRYPTION_KEY=
# 轮换时保留旧主密钥（逗号分隔），执行 rotate_api_keys 后删除旧值。
APP_ENCRYPTION_PREVIOUS_KEYS=
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# 每位用户通过网页提供自己的 DeepSeek Key，不配置共享 Key。
DEEPSEEK_BASE_URL=https://api.deepseek.com
LLM_TIMEOUT=45
LLM_DAILY_REQUEST_LIMIT=100
LLM_DAILY_TOKEN_LIMIT=100000
LLM_MAX_TOKENS=2048
# 首次下载中文 BGE，已下载后离线可用。tfidf 是明确选用的词法基线。
EMBEDDING_PROVIDER=bge
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
EMBEDDING_REVISION=7999e1d3359715c523056ef9478215996d62a620
RAG_MIN_SCORE=0.45
EXECUTION_PROVIDER=piston
PISTON_BASE_URL=https://emkc.org/api/v2/piston
PISTON_API_KEY=
JUDGE0_BASE_URL=https://ce.judge0.com
JUDGE0_API_KEY=
JUDGE0_AUTH_HEADER=X-Auth-Token
JUDGE0_PYTHON_LANGUAGE_ID=71
MASTERY_ESTIMATOR=rule

PISTON_PYTHON_VERSION=3.x
JUDGE0_RAPIDAPI_KEY=
JUDGE0_RAPIDAPI_HOST=judge0-ce.p.rapidapi.com

# Wikipedia uses its official public API; never send a student's DeepSeek Key.
WIKIPEDIA_ENABLED=true
WIKIPEDIA_DEFAULT_LANGUAGE=zh
WIKIPEDIA_FALLBACK_LANGUAGE=en
# Read timeout in seconds (1-30); connect timeout is at most 3 seconds.
WIKIPEDIA_TIMEOUT=6
# Shared public article cache lifetime in days (1-365); old articles are labelled stale.
WIKIPEDIA_CACHE_TTL_DAYS=7
WIKIPEDIA_USER_AGENT=AlgoMentor/1.1 (https://github.com/Oookla28/AlgoMentor; educational knowledge retrieval)
OFFLINE_FALLBACK_ENABLED=true
# Failure cooldown in seconds (5-3600). No background paid AI health requests.
EXTERNAL_SERVICE_CHECK_INTERVAL=60
# Default forbids implicit model downloads during retrieval. Prepare weights first.
LOCAL_EMBEDDING_OFFLINE_MODE=true

# EvidenceRAG Studio (additive; legacy remains the default).
EVIDENCE_RAG_ENABLED=true
# legacy | advanced
EVIDENCE_RAG_DEFAULT_MODE=legacy
# Chat uses the same compatible wrapper only when explicitly switched.
EVIDENCE_RAG_CHAT_MODE=legacy
EVIDENCE_RAG_INDEX_VERSION=adv-v1
EVIDENCE_RAG_PARENT_TOKEN_MIN=1200
EVIDENCE_RAG_PARENT_TOKEN_MAX=2000
EVIDENCE_RAG_CHILD_TOKEN_MIN=300
EVIDENCE_RAG_CHILD_TOKEN_MAX=500
EVIDENCE_RAG_CHILD_OVERLAP_RATIO=0.12
EVIDENCE_RAG_RRF_K=60
EVIDENCE_RAG_TOP_K=6
EVIDENCE_RAG_ROUTE_TOP_K=20
EVIDENCE_RAG_MAX_QUERY_VARIANTS=5
EVIDENCE_RAG_CONTEXT_TOKEN_BUDGET=1800
EVIDENCE_RAG_DENSE_MIN_SCORE=0.20
EVIDENCE_RAG_MIN_RERANK_SCORE=0.12
# Refuse when neither multi-character lexical overlap nor a strong semantic score supports the hit.
EVIDENCE_RAG_MIN_LEXICAL_OVERLAP=0.20
EVIDENCE_RAG_MIN_DENSE_SUPPORT=0.35
# deterministic | cross_encoder
EVIDENCE_RAG_RERANK_BACKEND=deterministic
EVIDENCE_RAG_CROSS_ENCODER_MODEL=BAAI/bge-reranker-base
# Off by default: rewritten queries must never become facts.
EVIDENCE_RAG_QUERY_REWRITE_LLM=false
EVIDENCE_RAG_CONFLICT_SIMILARITY=0.55
EVIDENCE_RAG_CONFLICT_SCORE_GAP=0.12
EVIDENCE_RAG_MAX_UPLOAD_BYTES=20971520
# Optional heavy backends stay disabled unless installed and explicitly enabled.
EVIDENCE_RAG_OCR_ENABLED=false
EVIDENCE_RAG_ASR_ENABLED=false
EVIDENCE_RAG_OCR_LANG=chi_sim+eng
# Override only when the default data/chroma path is unsuitable.
# CHROMA_PATH=/absolute/path/to/chroma

# Evidence-grounded platform agent (additive; no external calls by default).
PLATFORM_AGENT_ENABLED=true
PLATFORM_GATE_MIN_COVERAGE=0.15
PLATFORM_GATE_MIN_SUPPORT=0.30
PLATFORM_AGENT_MAX_STEPS=20
PLATFORM_AGENT_MAX_TOKENS=6000
PLATFORM_AGENT_MAX_TOOL_CALLS=8
PLATFORM_AGENT_MAX_LATENCY_MS=30000
PLATFORM_AGENT_MAX_RETRIEVE_MORE=2
# Local deployment scripts use these defaults; do not expose the demo server publicly.
DEPLOY_PORT=8010
# CHROMA_PATH=/tmp/algomentor-deploy-chroma
